---
import '../styles/global.css';
import { defaultPortfolioData } from '../data/portfolioData';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Julian Vance — Staff Software & Systems Engineer", 
  description = "Single-screen developer portfolio and profile for Julian Vance. Distributed systems, real-time architectures, and developer tooling."
} = Astro.props;

const canonicalUrl = "https://julianvance.dev";
const profile = defaultPortfolioData.profile;
const socials = defaultPortfolioData.socials;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": profile.name,
    "jobTitle": profile.role,
    "description": profile.bio,
    "image": profile.avatarUrl,
    "url": canonicalUrl,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "San Francisco",
      "addressRegion": "CA",
      "addressCountry": "US"
    },
    "sameAs": socials.map((s) => s.url)
  }
};
---

<!doctype html>
<html lang="en" class="min-h-screen lg:h-screen w-full lg:overflow-hidden" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="keywords" content="Julian Vance, Staff Engineer, Systems Engineer, Full-Stack, Rust, Go, TypeScript, Distributed Systems, eBPF, Astro Portfolio" />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={profile.avatarUrl} />
    <meta property="og:site_name" content={`${profile.name} Portfolio`} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={profile.avatarUrl} />
    <meta name="twitter:creator" content="@julianvance" />

    {/* Structured Data: JSON-LD Schema.org */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    {/* Enforce pure light theme */}
    <script is:inline>
      try {
        document.documentElement.setAttribute('data-theme', 'light');
        document.documentElement.classList.remove('dark');
        document.documentElement.style.colorScheme = 'light';
        localStorage.setItem('theme_preset', 'light');
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen lg:h-screen w-full bg-[#fcfcfc] text-zinc-900 flex flex-col font-sans antialiased lg:overflow-hidden">
    <slot />
  </body>
</html>
