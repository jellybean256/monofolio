---
import '../styles/global.css';
import { defaultPortfolioData } from '../data/portfolioData';

interface Props {
  title?: string;
  description?: string;
  isPreview?: boolean;
}

const { 
  title = "Julian Vance — Staff Software & Systems Engineer", 
  description = "Single-screen developer portfolio and profile for Julian Vance. Distributed systems, real-time architectures, and developer tooling.",
  isPreview = false
} = Astro.props;

const siteUrl = "https://monofolio-ten.vercel.app";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const profile = defaultPortfolioData.profile;
const socials = defaultPortfolioData.socials;
const ogImage = profile.avatarUrl ? profile.avatarUrl.replace(/\.webp$/, '.png') : '/avatar.png';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": profile.name,
    "jobTitle": profile.role,
    "description": profile.bio,
    "image": profile.avatarUrl,
    "url": canonicalUrl,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "San Francisco",
      "addressRegion": "CA",
      "addressCountry": "US"
    },
    "sameAs": socials.map((s) => s.url)
  }
};
---

<!doctype html>
<html lang="en" class={isPreview ? "h-full w-full overflow-hidden" : "min-h-screen lg:h-screen w-full lg:overflow-hidden"} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    {/* Primary Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="keywords" content="Julian Vance, Staff Engineer, Systems Engineer, Full-Stack, Rust, Go, TypeScript, Distributed Systems, eBPF, Astro Portfolio" />
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="light" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={`${profile.name} Portfolio`} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@julianvance" />

    {/* Structured Data: JSON-LD Schema.org */}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    {/* Enforce pure light theme */}
    <script is:inline>
      try {
        document.documentElement.setAttribute('data-theme', 'light');
        document.documentElement.classList.remove('dark');
        document.documentElement.style.colorScheme = 'light';
        localStorage.setItem('theme_preset', 'light');
      } catch (e) {}
    </script>

    {/* Global sleek Geist scrollbars */}
    <style is:global>
      html, body {
        scrollbar-width: thin;
        scrollbar-color: #d4d4d8 transparent;
      }
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background-color: #d4d4d8;
        border-radius: 9999px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background-color: #a1a1aa;
      }
    </style>
  </head>
  <body class={isPreview ? "h-full w-full bg-[#fcfcfc] text-zinc-900 flex flex-col font-sans antialiased overflow-hidden" : "min-h-screen lg:h-screen w-full bg-[#fcfcfc] text-zinc-900 flex flex-col font-sans antialiased lg:overflow-hidden [scrollbar-width:thin] [scrollbar-color:#d4d4d8_transparent]"}>
    {isPreview ? (
      <div id="preview-viewport-root" class="h-full w-full overflow-y-auto overflow-x-hidden [scrollbar-width:thin] [scrollbar-color:#d4d4d8_transparent] flex flex-col">
        <slot />
      </div>
    ) : (
      <slot />
    )}
  </body>
</html>
