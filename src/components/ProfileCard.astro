---
import { developerProfile, socialLinks } from '../data/portfolioData';
import ThemeToggle from './ThemeToggle';
import ShareButton from './ShareButton';
---

<div class="w-full bg-white/80 dark:bg-zinc-900/60 rounded-xl border border-zinc-200/60 dark:border-zinc-800/60 p-3 sm:p-3.5 shrink-0">
  <div class="flex flex-col md:flex-row items-center justify-between gap-3 md:gap-4">
    {/* Left: Avatar + Name + Role + Location + Joined */}
    <div class="flex items-center gap-3.5 shrink-0 w-full md:w-auto">
      <img
        src={developerProfile.avatarUrl}
        alt={`Profile portrait of ${developerProfile.name}`}
        class="w-16 h-16 sm:w-18 sm:h-18 rounded-full object-cover ring-2 ring-zinc-200/90 dark:ring-zinc-700/80 shadow-xs shrink-0"
        loading="eager"
      />

      <div class="min-w-0 flex-1">
        <h1 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 tracking-tight leading-tight truncate">
          {developerProfile.name}
        </h1>
        <p class="text-xs font-mono text-zinc-600 dark:text-zinc-400 mt-0.5 truncate">
          {developerProfile.role}
        </p>
        <div class="flex items-center gap-2 text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-1 flex-wrap">
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-zinc-400 dark:text-zinc-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{developerProfile.location}</span>
          </span>
          <span class="text-zinc-300 dark:text-zinc-700">·</span>
          <span>{developerProfile.joinedDate}</span>
        </div>
      </div>
    </div>

    {/* Middle: Bio (Desktop view) */}
    <div class="hidden lg:block flex-1 min-w-0 max-w-md xl:max-w-lg px-4 border-l border-zinc-200/60 dark:border-zinc-800/60">
      <p class="text-xs font-mono text-zinc-600 dark:text-zinc-300 leading-relaxed line-clamp-3">
        {developerProfile.bio}
      </p>
    </div>

    {/* Right: Contact Links + Naturally Integrated Share & Theme Controls */}
    <div class="flex items-center justify-between md:justify-end gap-2 sm:gap-3 shrink-0 w-full md:w-auto pt-2 md:pt-0 border-t md:border-t-0 border-zinc-100 dark:border-zinc-800/60">
      {/* Contact links */}
      <div class="flex items-center gap-1 flex-wrap">
        {socialLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noreferrer"
            aria-label={link.ariaLabel}
            class="flex items-center gap-1 px-2 py-1 rounded-md text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100/80 dark:hover:bg-zinc-800/60 transition-colors group cursor-pointer"
          >
            {link.icon === 'github' && (
              <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 shrink-0 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            )}
            {link.icon === 'linkedin' && (
              <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-blue-500 shrink-0 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
              </svg>
            )}
            {link.icon === 'twitter' && (
              <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 shrink-0 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            )}
            {link.icon === 'mail' && (
              <svg class="w-3.5 h-3.5 text-zinc-400 group-hover:text-rose-500 shrink-0 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            )}
            <span>{link.name}</span>
          </a>
        ))}
      </div>

      {/* Share & Theme docked cleanly */}
      <div class="flex items-center gap-1 pl-2 border-l border-zinc-200/60 dark:border-zinc-800 shrink-0">
        <ShareButton client:load />
        <ThemeToggle client:load />
      </div>
    </div>
  </div>
</div>
