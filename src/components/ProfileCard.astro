---
import { developerProfile } from '../data/portfolioData';
import ThemeToggle from './ThemeToggle';
import ShareButton from './ShareButton';
---

<div class="bg-white/80 dark:bg-zinc-900/60 rounded-xl border border-zinc-200/60 dark:border-zinc-800/60 p-3.5 sm:p-4 shrink-0">
  {/* Top Row: Avatar & Identity on Left, Share & Theme Controls on Right */}
  <div class="flex items-start justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <img
        src={developerProfile.avatarUrl}
        alt={`Profile portrait of ${developerProfile.name}`}
        class="w-11 h-11 rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-700 shrink-0"
        loading="eager"
      />

      <div class="min-w-0 flex-1">
        <h1 class="text-sm sm:text-base font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight truncate">
          {developerProfile.name}
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 truncate">
          {developerProfile.role}
        </p>
        <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-0.5 truncate">
          {developerProfile.location} <span class="text-zinc-300 dark:text-zinc-700">·</span> {developerProfile.timezone}
        </p>
      </div>
    </div>

    {/* Integrated Share and Theme controls */}
    <div class="flex items-center gap-1 shrink-0 pt-0.5">
      <ShareButton client:load />
      <ThemeToggle client:load />
    </div>
  </div>

  {/* Short Bio */}
  <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed mt-3">
    {developerProfile.bio}
  </p>
</div>
