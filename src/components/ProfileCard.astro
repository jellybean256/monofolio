---
import { developerProfile } from '../data/portfolioData';
---

<div class="bg-white/80 dark:bg-zinc-900/60 rounded-xl border border-zinc-200/60 dark:border-zinc-800/60 p-3.5 sm:p-4 flex flex-col justify-between shrink-0">
  <div>
    {/* Top row: Avatar + Identity */}
    <div class="flex items-start gap-3">
      <img
        src={developerProfile.avatarUrl}
        alt={`Profile portrait of ${developerProfile.name}`}
        class="w-10 h-10 rounded-full object-cover ring-1 ring-zinc-200 dark:ring-zinc-700 shrink-0"
        loading="eager"
      />

      <div class="min-w-0 flex-1">
        <h1 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight truncate">
          {developerProfile.name}
        </h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 truncate">
          {developerProfile.role}
        </p>
        <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-0.5">
          {developerProfile.location} <span class="text-zinc-300 dark:text-zinc-700">·</span> {developerProfile.timezone}
        </p>
      </div>
    </div>

    {/* Bio */}
    <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed mt-3">
      {developerProfile.bio}
    </p>
  </div>

  {/* Subtle, unboxed stats line (replaces noisy dashboard boxes) */}
  <div class="flex items-center justify-between pt-3 mt-3 border-t border-zinc-100 dark:border-zinc-800/60 text-xs">
    {developerProfile.metrics.map((m, idx) => (
      <div class="flex items-baseline gap-1">
        <span class="font-mono font-medium text-zinc-800 dark:text-zinc-200 text-xs">
          {m.value}
        </span>
        <span class="text-[11px] text-zinc-400 dark:text-zinc-500">
          {m.label.toLowerCase()}
        </span>
        {idx < developerProfile.metrics.length - 1 && (
          <span class="text-zinc-300 dark:text-zinc-700 ml-2">·</span>
        )}
      </div>
    ))}
  </div>
</div>
