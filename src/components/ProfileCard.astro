---
import { developerProfile } from '../data/portfolioData';
---

<div class="bg-white dark:bg-zinc-900/90 rounded-xl border border-slate-200/90 dark:border-zinc-800/80 p-3.5 shadow-2xs flex flex-col justify-between shrink-0">
  <div>
    {/* Top: Avatar + Identity */}
    <div class="flex items-start gap-3 mb-2.5">
      <div class="relative shrink-0">
        <img
          src={developerProfile.avatarUrl}
          alt={`Profile portrait of ${developerProfile.name}`}
          class="w-12 h-12 rounded-lg object-cover border border-slate-200 dark:border-zinc-700/80 shadow-2xs"
          loading="eager"
        />
        <div 
          class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-emerald-500 border-2 border-white dark:border-zinc-900"
          title="Available for select opportunities"
        ></div>
      </div>

      <div class="min-w-0 flex-1">
        <div class="flex items-center justify-between gap-1">
          <h1 class="text-sm font-bold text-slate-900 dark:text-zinc-100 tracking-tight truncate">
            {developerProfile.name}
          </h1>
          <span class="text-3xs font-mono px-1.5 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border border-emerald-200/60 dark:border-emerald-800/50">
            Active
          </span>
        </div>
        
        <p class="text-2xs font-medium text-slate-700 dark:text-zinc-300 truncate mt-0.5">
          {developerProfile.role}
        </p>

        <div class="flex items-center gap-1 text-3xs text-slate-500 dark:text-zinc-400 mt-1">
          <svg class="w-3 h-3 shrink-0 text-slate-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="truncate">{developerProfile.location}</span>
          <span class="text-slate-300 dark:text-zinc-600">•</span>
          <span class="font-mono">{developerProfile.timezone}</span>
        </div>
      </div>
    </div>

    {/* Bio description */}
    <p class="text-2xs text-slate-600 dark:text-zinc-400 leading-relaxed">
      {developerProfile.bio}
    </p>
  </div>

  {/* Metrics Strip */}
  <div class="grid grid-cols-3 gap-1.5 mt-3 pt-2.5 border-t border-slate-100 dark:border-zinc-800/70">
    {developerProfile.metrics.map((m) => (
      <div class="bg-slate-50/80 dark:bg-zinc-800/50 rounded-lg p-1.5 text-center border border-slate-200/50 dark:border-zinc-800/50">
        <span class="block text-xs font-bold text-slate-900 dark:text-zinc-100 font-mono">
          {m.value}
        </span>
        <span class="block text-3xs text-slate-500 dark:text-zinc-400 leading-tight">
          {m.label}
        </span>
      </div>
    ))}
  </div>
</div>
