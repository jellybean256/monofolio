---
import { techStackCategories } from '../data/portfolioData';

// Flatten into one unified list without category divisions
const allSkills = techStackCategories.flatMap((cat) => cat.skills);
---

<div class="flex-1 min-h-0 bg-white/80 dark:bg-zinc-900/60 rounded-xl border border-zinc-200/60 dark:border-zinc-800/60 p-4 flex flex-col justify-between overflow-hidden">
  <div class="flex items-center justify-between mb-3 shrink-0">
    <span class="text-xs font-semibold text-zinc-900 dark:text-zinc-100">
      Tech Stack
    </span>
  </div>

  {/* Unified single list of technologies - all with consistent, subtle visual treatment */}
  <div class="flex-1 min-h-0 overflow-y-auto custom-scrollbar pr-0.5">
    <div class="flex flex-wrap gap-1.5">
      {allSkills.map((skill) => (
        <span
          class="text-xs px-2.5 py-1 rounded-md font-mono text-zinc-700 dark:text-zinc-300 bg-zinc-100/70 dark:bg-zinc-800/50 border border-zinc-200/50 dark:border-zinc-700/40 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors"
        >
          {skill.name}
        </span>
      ))}
    </div>
  </div>
</div>
