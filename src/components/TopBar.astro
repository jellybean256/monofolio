---
import ThemeToggle from './ThemeToggle';
import ShareButton from './ShareButton';
import { developerProfile } from '../data/portfolioData';
---

<header class="h-11 border-b border-zinc-200/60 dark:border-zinc-800/60 bg-white/60 dark:bg-zinc-950/60 backdrop-blur-md px-4 sm:px-6 flex items-center justify-between shrink-0 select-none z-20">
  {/* Left: Brand / Title */}
  <div class="flex items-center gap-2">
    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shrink-0"></span>
    <span class="font-mono text-xs font-medium text-zinc-900 dark:text-zinc-100 tracking-tight">
      {developerProfile.name.toLowerCase().replace(/\s+/g, '')}.dev
    </span>
    <span class="hidden sm:inline text-zinc-300 dark:text-zinc-700">/</span>
    <span class="hidden sm:inline text-xs text-zinc-500 dark:text-zinc-400">
      {developerProfile.role}
    </span>
  </div>

  {/* Right: Actions */}
  <div class="flex items-center gap-1">
    <ShareButton client:load />
    <ThemeToggle client:load />
  </div>
</header>
