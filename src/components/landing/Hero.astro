---
---

<header class="w-full max-w-5xl mx-auto pt-6 sm:pt-10 pb-8 sm:pb-12 px-4 sm:px-6 flex flex-col items-center text-center">
  {/* Top Navbar */}
  <nav class="w-full flex items-center justify-between pb-8 sm:pb-14" aria-label="Main Navigation">
    {/* Brand Logo / Moniker */}
    <a href="/" class="flex items-center gap-2 font-mono text-xs sm:text-sm font-semibold text-zinc-900 tracking-tight hover:opacity-80 transition-opacity" aria-label="mono.folio home">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
      <span>mono.folio</span>
    </a>

    {/* Right Nav Actions */}
    <div class="flex items-center gap-4">
      <a 
        href="https://github.com/jellybean256/monofolio" 
        target="_blank" 
        rel="noreferrer"
        class="hidden sm:flex items-center gap-1.5 text-xs font-mono text-zinc-600 hover:text-zinc-900 transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
      </a>

      <a
        href="/builder"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-zinc-900 text-zinc-50 text-xs font-medium hover:bg-zinc-800 transition-colors shadow-xs"
      >
        <span>Open Studio</span>
        <span class="text-zinc-400" aria-hidden="true">→</span>
      </a>
    </div>
  </nav>

  {/* Hero Content */}
  <div class="flex flex-col items-center max-w-2xl">
    {/* Minimal Tagline Pill */}
    <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full border border-zinc-200/80 bg-zinc-50 text-[11px] font-mono text-zinc-600 mb-5">
      <span class="text-zinc-500" aria-hidden="true">#</span>
      <span>Single-Screen Portfolio Engine</span>
    </div>

    {/* Headline */}
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-zinc-900 tracking-tight leading-[1.15] mb-4">
      A single-screen portfolio for builders.
    </h1>

    {/* Subheadline */}
    <p class="text-sm sm:text-base text-zinc-600 leading-relaxed font-sans max-w-xl mb-6">
      Zero complex drag-and-drop, zero rigid templates. Assemble your career history and projects in minutes, then publish a precision portfolio that fits on a single screen.
    </p>

    {/* CTA Button & Micro-copy */}
    <div class="flex flex-col items-center gap-3">
      <a
        href="/builder"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-zinc-900 text-white font-medium text-sm hover:bg-zinc-800 transition-all shadow-sm hover:shadow active:scale-[0.99]"
      >
        <span>Start Building — Free</span>
        <span class="text-zinc-400 font-mono" aria-hidden="true">→</span>
      </a>

      <div class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-xs font-mono text-zinc-600 text-center">
        <span class="whitespace-nowrap">No sign-up</span>
        <span class="text-zinc-400" aria-hidden="true">•</span>
        <span class="whitespace-nowrap">100% instant</span>
        <span class="text-zinc-400" aria-hidden="true">•</span>
        <span class="whitespace-nowrap">Single-screen fit</span>
      </div>
    </div>
  </div>
</header>
