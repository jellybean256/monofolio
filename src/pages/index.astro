---
import Layout from '../layouts/Layout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ProjectsArea from '../components/ProjectsArea';
import GithubContributions from '../components/GithubContributions';
import { publicProjects, closedProjects } from '../data/portfolioData';
---

<Layout>
  {/* Single-Screen on Desktop, Fluid Scrollable on Mobile without tabs */}
  <main class="min-h-screen lg:h-screen w-full lg:w-screen p-3.5 sm:p-5 lg:p-4 overflow-y-auto lg:overflow-hidden flex flex-col">
    {/* Combined Two-Column Layout on Desktop, Single Continuous Vertical Flow on Mobile */}
    <div class="flex flex-col gap-6 lg:grid lg:grid-cols-12 lg:gap-3 lg:items-stretch">
      {/* Left Column on Desktop / Top Section on Mobile: Profile */}
      <section 
        id="panel-profile"
        aria-label="Developer Profile"
        class="flex flex-col lg:col-span-4 xl:col-span-4 2xl:col-span-3.5 lg:h-full lg:min-h-0 lg:overflow-hidden shrink-0"
      >
        <ProfileCard />
      </section>

      {/* Right Column on Desktop / Bottom Section on Mobile: Projects + GitHub Activity */}
      <section 
        id="panel-work"
        aria-label="Engineering Projects and GitHub Activity"
        class="flex flex-col gap-5 lg:gap-3 lg:col-span-8 xl:col-span-8 2xl:col-span-8.5 lg:h-fit lg:min-h-0 lg:overflow-hidden"
      >
        {/* Projects Area */}
        <ProjectsArea 
          client:load 
          publicProjects={publicProjects} 
          closedProjects={closedProjects} 
        />

        {/* GitHub Activity */}
        <GithubContributions client:load />
      </section>
    </div>
  </main>
</Layout>
