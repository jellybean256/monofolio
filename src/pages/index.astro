---
import Layout from '../layouts/Layout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import ProjectsArea from '../components/ProjectsArea';
import GithubContributions from '../components/GithubContributions';
import { publicProjects, closedProjects } from '../data/portfolioData';
---

<Layout>
  {/* Option A: "The Unified Studio" Dashboard - strictly fits within 100dvh */}
  <main class="h-screen w-screen p-2.5 sm:p-3.5 lg:p-4 overflow-hidden flex flex-col">
    {/* Responsive View Switcher for mobile / tablet screens */}
    <div class="lg:hidden flex items-center justify-center shrink-0 mb-2">
      <div 
        role="tablist" 
        aria-label="Dashboard View Selector"
        class="inline-flex p-0.5 rounded-lg bg-zinc-200/70 dark:bg-zinc-800/80 text-xs font-medium"
      >
        <button
          id="btn-view-profile"
          role="tab"
          aria-selected="true"
          aria-controls="panel-profile"
          class="px-3 py-1 rounded-md text-xs font-medium transition-colors bg-white dark:bg-zinc-700 text-zinc-900 dark:text-zinc-100 shadow-2xs cursor-pointer"
        >
          Profile
        </button>
        <button
          id="btn-view-work"
          role="tab"
          aria-selected="false"
          aria-controls="panel-work"
          class="px-3 py-1 rounded-md text-xs font-medium transition-colors text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 cursor-pointer"
        >
          Projects & Activity
        </button>
      </div>
    </div>

    {/* Two-Column Balanced Studio Layout */}
    <div class="flex-1 min-h-0 grid grid-cols-1 lg:grid-cols-12 gap-3 overflow-hidden">
      {/* Left Column: Full-Height Profile Card */}
      <section 
        id="panel-profile"
        role="tabpanel"
        aria-label="Developer Profile"
        class="flex lg:flex lg:col-span-4 xl:col-span-4 2xl:col-span-3.5 flex-col h-full min-h-0 overflow-hidden"
      >
        <ProfileCard />
      </section>

      {/* Right Column: Projects (Top) + GitHub Activity (Bottom) */}
      <section 
        id="panel-work"
        role="tabpanel"
        aria-label="Engineering Projects and GitHub Activity"
        class="hidden lg:flex lg:col-span-8 xl:col-span-8 2xl:col-span-8.5 flex-col gap-3 h-full min-h-0 overflow-hidden"
      >
        {/* Projects Area: takes remaining vertical space with internal scroll */}
        <div class="flex-1 min-h-0 flex flex-col overflow-hidden">
          <ProjectsArea 
            client:load 
            publicProjects={publicProjects} 
            closedProjects={closedProjects} 
          />
        </div>

        {/* GitHub Activity: anchored at bottom, fills 100% of the right column width */}
        <GithubContributions client:load />
      </section>
    </div>
  </main>

  <script is:inline>
    const btnProfile = document.getElementById('btn-view-profile');
    const btnWork = document.getElementById('btn-view-work');
    const panelProfile = document.getElementById('panel-profile');
    const panelWork = document.getElementById('panel-work');

    function setView(view) {
      if (!btnProfile || !btnWork || !panelProfile || !panelWork) return;

      if (view === 'profile') {
        panelProfile.classList.remove('hidden');
        panelProfile.classList.add('flex');
        panelWork.classList.add('hidden');
        panelWork.classList.remove('flex');
        
        btnProfile.setAttribute('aria-selected', 'true');
        btnProfile.className = 'px-3 py-1 rounded-md text-xs font-medium transition-colors bg-white dark:bg-zinc-700 text-zinc-900 dark:text-zinc-100 shadow-2xs cursor-pointer';
        
        btnWork.setAttribute('aria-selected', 'false');
        btnWork.className = 'px-3 py-1 rounded-md text-xs font-medium transition-colors text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 cursor-pointer';
      } else {
        panelWork.classList.remove('hidden');
        panelWork.classList.add('flex');
        panelProfile.classList.add('hidden');
        panelProfile.classList.remove('flex');

        btnWork.setAttribute('aria-selected', 'true');
        btnWork.className = 'px-3 py-1 rounded-md text-xs font-medium transition-colors bg-white dark:bg-zinc-700 text-zinc-900 dark:text-zinc-100 shadow-2xs cursor-pointer';

        btnProfile.setAttribute('aria-selected', 'false');
        btnProfile.className = 'px-3 py-1 rounded-md text-xs font-medium transition-colors text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 cursor-pointer';
      }
    }

    btnProfile?.addEventListener('click', () => setView('profile'));
    btnWork?.addEventListener('click', () => setView('work'));
  </script>
</Layout>
